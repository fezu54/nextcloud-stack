# 1. Silent Bans: Block the attacker, but suppress noisy ntfy push notifications
# for scenarios listed below.
name: silent_bans
filters:
  - >-
    Alert.Remediation == true && Alert.GetScope() == "Ip" && Alert.GetScenario() in [
      "crowdsecurity/http-open-proxy",
      "crowdsecurity/CVE-2022-41082",
      "crowdsecurity/http-crawl-non_statics",
      "crowdsecurity/http-probing",
      "crowdsecurity/http-admin-interface-probing",
      "crowdsecurity/http-sensitive-files",
      "crowdsecurity/http-wordpress-scan",
      "crowdsecurity/thinkphp-cve-2018-20062",
      "crowdsecurity/CVE-2017-9841",
      "crowdsecurity/http-cve-2021-42013",
      "crowdsecurity/http-cve-2021-41773",
      "crowdsecurity/CVE-2019-18935",
      "crowdsecurity/http-backdoors-attempts",
    ]
decisions:
  - type: ban
    duration: 4h
# No notifications list -> silences alerts for these scenarios
on_success: break
---
# 2. High-Priority & Unmuted Alerts: Ban the attacker AND send real-time push notification
# for SSH brute-force, Nextcloud account attacks, or new/unfiltered CVE exploits.
name: default_ip_remediation
filters:
  - Alert.Remediation == true && Alert.GetScope() == "Ip"
decisions:
  - type: ban
    duration: 4h
notifications:
  - http_ntfy
on_success: break
